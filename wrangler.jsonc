{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "koper-shore-excursions",
  "compatibility_date": "2026-06-25",
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./out",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
